---
import { tw } from '../styles/utilities';
import type { Lang } from '../lib/site';
import { copy } from '../lib/site';

interface Props { lang: Lang }
const t = copy[Astro.props.lang].sessionDetail;
const events = [
  { total: '312.4K', added: '+1.2K', input: '311.1K', cached: '286.8K', output: '1.3K' },
  { total: '784.6K', added: '+8.5K', input: '781.2K', cached: '720.4K', output: '3.4K' },
  { total: '1.09M', added: '+2.1K', input: '1.08M', cached: '992.5K', output: '5.1K' },
];
---
<div class={tw('session-detail-demo')}>
  <div class={tw('session-detail-demo-top')}><span class={tw('session-detail-demo-dots')} aria-hidden="true"><i></i><i></i><i></i></span><strong>Codex Usage Desktop</strong></div>
  <div class={tw('session-detail-demo-body')}>
    <div class={tw('session-detail-demo-heading')}><div><span>{t.example}</span><h3>{t.sampleTitle}</h3></div><span class={tw('session-detail-demo-tab')}>{t.timeline}</span></div>
    <div class={tw('session-detail-demo-summary')}>
      <div class={tw('session-detail-demo-total')}><span>{t.total}</span><strong>1.09M</strong><small>tokens</small><div class={tw('session-detail-demo-breakdown')}><span>{t.input} <b>1.08M</b></span><span>{t.cached} <b>992.5K</b></span><span>{t.output} <b>5.1K</b></span></div></div>
      <div class={tw('session-detail-demo-quota')}><span>{t.fiveHour}<strong>≈ 4%</strong><small>{t.estimated}</small></span><span>{t.weekly}<strong>&lt;1%</strong><small>{t.estimated}</small></span></div>
    </div>
    <h4>{t.timeline}</h4>
    <div class={tw('session-detail-demo-events')}>
      {events.map((event, index) => <div class={tw('session-detail-demo-event')}><span class={tw('session-detail-demo-marker')} aria-hidden="true"></span><div class={tw('session-detail-demo-event-body')}><div class={tw('session-detail-demo-event-head')}><strong>{t.events[index]}</strong><span><b>{event.total}</b> <em>({event.added})</em> tokens</span></div><p>{t.input} {event.input} · {t.cached} {event.cached} · {t.output} {event.output}</p></div></div>)}
    </div>
  </div>
</div>
