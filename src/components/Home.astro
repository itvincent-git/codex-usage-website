---
import BaseLayout from '../layouts/BaseLayout.astro';
import PrimaryDownload from './PrimaryDownload.astro';
import FeatureVisual from './FeatureVisual.astro';
import { copy, featureSlugs, pathFor, repo, site, type Lang } from '../lib/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copy[lang];
const softwareSchema = { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'Codex Usage Desktop', url: `${site}${pathFor(lang)}`, description: t.home.lead, applicationCategory: 'DeveloperApplication', operatingSystem: 'macOS, Windows 10, Windows 11', isAccessibleForFree: true, license: `${repo}/blob/main/LICENSE`, downloadUrl: `${site}${pathFor(lang, 'download')}`, inLanguage: t.locale };
---
<BaseLayout lang={lang} title={`Codex Usage Desktop — ${t.home.title}`} description={t.home.lead} schema={softwareSchema}>
  <section class="hero relative bg-[#f9f8f5] py-[80px] pb-[92px] text-center max-[700px]:py-[62px] max-[700px]:pb-[70px] dark:bg-night-canvas">
    <div class="wrap mx-auto w-[min(1180px,calc(100%-48px))] max-[700px]:w-[min(560px,calc(100%-32px))]">
      <span class="eyebrow inline-flex items-center gap-2 text-[11px] font-extrabold uppercase tracking-[.14em] text-brand-label before:size-2 before:rounded-full before:bg-brand-dot before:shadow-[0_0_0_5px_#e9e0fb] before:content-[''] dark:text-brand-light">{t.home.eyebrow}</span>
      <h1>{t.home.title}</h1>
      <p class="lead">{t.home.lead}</p>
      <div class="hero-actions mt-[33px] flex justify-center gap-3 max-[700px]:flex-col max-[700px]:items-stretch max-[700px]:[&_.button]:w-full max-[700px]:[&_.primary-download]:w-full"><PrimaryDownload lang={lang} label={t.home.cta} /><a class="button inline-flex min-h-13 items-center justify-center gap-4 rounded-2xl border border-surface-border bg-white px-6 text-[15px] font-bold transition-[transform,box-shadow] duration-200 hover:-translate-y-0.5 hover:shadow-[0_10px_28px_#463e6540] focus-visible:outline-3 focus-visible:outline-offset-4 focus-visible:outline-[#8e6ed8] dark:border-night-border dark:bg-night-surface dark:text-[#f2eff8]" href="#features">{t.home.secondary} <span aria-hidden="true">↓</span></a></div>
      <div class="hero-proof mt-[26px] flex flex-wrap justify-center gap-[22px] text-xs font-semibold text-[#787c85] max-[700px]:gap-x-[17px] max-[700px]:gap-y-2.5 dark:text-[#bec0ca]">{t.home.proof.map((item) => <span>{item}</span>)}</div>
      <div class="window-stage relative mx-auto mt-[65px] max-w-[1060px] max-[700px]:mt-[42px]"><div class="app-window relative overflow-hidden rounded-[22px] border border-[#ffffffb8] bg-[#ffffffa6] p-2 shadow-[0_35px_90px_#4f4b7140,0_2px_5px_#5553] max-[700px]:rounded-[13px] max-[700px]:p-[5px] dark:border-[#414657] dark:bg-[#272b37]"><div class="window-top flex h-7 items-center gap-1.5 pl-[11px] max-[700px]:h-[18px]"><i></i><i></i><i></i></div><FeatureVisual slug="usage-tracking" label={t.features['usage-tracking'].imageAlt} /></div><p class="visual-note">{t.home.visualNote}</p></div>
    </div>
  </section>
  <section class="section py-28 max-[700px]:py-[75px] wrap mx-auto w-[min(1180px,calc(100%-48px))] max-[700px]:w-[min(560px,calc(100%-32px))]" id="features">
    <div class="section-heading mx-auto mb-12 max-w-[670px] text-center"><span class="eyebrow inline-flex items-center gap-2 text-[11px] font-extrabold uppercase tracking-[.14em] text-brand-label before:size-2 before:rounded-full before:bg-brand-dot before:shadow-[0_0_0_5px_#e9e0fb] before:content-[''] dark:text-brand-light">{t.nav.features}</span><h2>{t.home.sectionTitle}</h2><p>{t.home.sectionLead}</p></div>
    <div class="feature-grid grid grid-cols-2 gap-[18px] max-[700px]:grid-cols-1">
      {featureSlugs.map((slug, index) => { const f = t.features[slug]; return <a class:list={['feature-card relative flex h-[510px] min-h-0 flex-col overflow-hidden rounded-[26px] border border-[#e9e5e4] bg-white px-9 pt-9 transition-[transform,box-shadow] duration-[250ms] hover:-translate-y-1 hover:shadow-[0_20px_40px_#5c557225] focus-visible:outline-3 focus-visible:outline-offset-4 focus-visible:outline-[#8e6ed8] max-[700px]:h-auto max-[700px]:min-h-[400px] dark:border-[#39404e]', `feature-card--${slug}`]} href={pathFor(lang, slug)}><span class="feature-number text-xs font-extrabold tracking-[.1em] text-[#8f81b0] dark:text-brand-light">0{index + 1} / 04</span><h3>{f.name}</h3><p>{f.description}</p><span class="learn-link mt-5 text-sm font-bold text-[#6a57a5] dark:text-brand-light">{t.common.learn} <span aria-hidden="true">↗</span></span><span class="feature-media"><FeatureVisual slug={slug} compact label={f.imageAlt} /></span></a>; })}
    </div>
  </section>
  <section class="workflow-band"><div class="wrap mx-auto w-[min(1180px,calc(100%-48px))] max-[700px]:w-[min(560px,calc(100%-32px))]"><div class="section-heading mx-auto mb-12 max-w-[670px] text-center"><span class="eyebrow inline-flex items-center gap-2 text-[11px] font-extrabold uppercase tracking-[.14em] text-brand-label before:size-2 before:rounded-full before:bg-brand-dot before:shadow-[0_0_0_5px_#e9e0fb] before:content-[''] dark:text-brand-light">{t.home.workflowEyebrow}</span><h2>{t.home.workflowTitle}</h2><p>{t.home.workflowLead}</p></div><div class="workflow-grid">{t.home.workflow.map((step, index) => <div class="workflow-step"><span>0{index + 1}</span><h3>{step.title}</h3><p>{step.body}</p></div>)}</div></div></section>
  <section class="privacy-band bg-[#efeaf8] py-[88px] max-[700px]:py-[65px] dark:bg-[#252538]"><div class="wrap mx-auto w-[min(1180px,calc(100%-48px))] max-[700px]:w-[min(560px,calc(100%-32px))] split grid grid-cols-2 items-center gap-20 max-[700px]:grid-cols-1 max-[700px]:gap-[30px]"><div class="privacy-visual grid min-h-[270px] place-items-center rounded-[30px] shadow-[inset_0_1px_0_#fff9]" aria-hidden="true"><span>⌘</span></div><div class="split-copy"><span class="eyebrow inline-flex items-center gap-2 text-[11px] font-extrabold uppercase tracking-[.14em] text-brand-label before:size-2 before:rounded-full before:bg-brand-dot before:shadow-[0_0_0_5px_#e9e0fb] before:content-[''] dark:text-brand-light">{t.docs.names.privacy}</span><h2>{t.home.privacyTitle}</h2><p>{t.home.privacyBody}</p><a class="text-link font-bold text-brand-link hover:underline dark:text-brand-light" href={pathFor(lang, 'docs/privacy')}>{t.home.privacyLink} <span aria-hidden="true">↗</span></a></div></div></section>
  <section class="closing px-5 py-[100px] text-center max-[700px]:px-4 max-[700px]:py-20"><h2>{t.home.closing}</h2><PrimaryDownload lang={lang} label={t.home.cta} /></section>
</BaseLayout>
