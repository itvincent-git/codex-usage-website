---
import BaseLayout from '../layouts/BaseLayout.astro';
import PrimaryDownload from './PrimaryDownload.astro';
import { copy, featureSlugs, pathFor, repo, site, type Lang } from '../lib/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copy[lang];
const softwareSchema = { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'Codex Usage Desktop', url: `${site}${pathFor(lang)}`, description: t.home.lead, applicationCategory: 'DeveloperApplication', operatingSystem: 'macOS, Windows 10, Windows 11', isAccessibleForFree: true, license: `${repo}/blob/main/LICENSE`, downloadUrl: `${site}${pathFor(lang, 'download')}`, inLanguage: t.locale };
---
<BaseLayout lang={lang} title={`Codex Usage Desktop — ${t.home.title}`} description={t.home.lead} schema={softwareSchema}>
  <section class="hero">
    <div class="wrap">
      <span class="eyebrow">{t.home.eyebrow}</span>
      <h1>{t.home.title}</h1>
      <p class="lead">{t.home.lead}</p>
      <div class="hero-actions"><PrimaryDownload lang={lang} label={t.home.cta} /><a class="button" href="#features">{t.home.secondary} <span aria-hidden="true">↓</span></a></div>
      <div class="hero-proof">{t.home.proof.map((item) => <span>{item}</span>)}</div>
      <div class="window-stage"><div class="app-window"><div class="window-top"><i></i><i></i><i></i></div><img src="/images/dashboard.jpg" width="3002" height="1962" alt={t.features['usage-tracking'].imageAlt} fetchpriority="high" /></div></div>
    </div>
  </section>
  <section class="section wrap" id="features">
    <div class="section-heading"><span class="eyebrow">{t.nav.features}</span><h2>{t.home.sectionTitle}</h2><p>{t.home.sectionLead}</p></div>
    <div class="feature-grid">
      {featureSlugs.map((slug, index) => { const f = t.features[slug]; return <a class="feature-card" href={pathFor(lang, slug)}><span class="feature-number">0{index + 1} / 04</span><h3>{f.name}</h3><p>{f.description}</p><span class="learn-link">{t.common.learn} <span aria-hidden="true">↗</span></span><img src={f.image} alt={f.imageAlt} loading="lazy" /></a>; })}
    </div>
  </section>
  <section class="privacy-band"><div class="wrap split"><div class="privacy-visual" aria-hidden="true"><span>⌘</span></div><div class="split-copy"><span class="eyebrow">{t.docs.names.privacy}</span><h2>{t.home.privacyTitle}</h2><p>{t.home.privacyBody}</p><a class="text-link" href={pathFor(lang, 'docs/privacy')}>{t.home.privacyLink} <span aria-hidden="true">↗</span></a></div></div></section>
  <section class="closing"><h2>{t.home.closing}</h2><PrimaryDownload lang={lang} label={t.home.cta} /></section>
</BaseLayout>
