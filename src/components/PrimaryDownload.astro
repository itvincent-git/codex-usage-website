---
import { copy, downloads, pathFor, type Lang } from '../lib/site';
interface Props { lang: Lang; label: string; className?: string }
const { lang, label, className = '' } = Astro.props;
---
<div class={`primary-download relative ${className}`} data-download-widget data-mac-label={`${label} macOS`} data-windows-label={`${label} Windows`}>
  <a class="button inline-flex min-h-13 items-center justify-center gap-4 rounded-2xl border border-surface-border bg-white px-6 text-[15px] font-bold transition-[transform,box-shadow] duration-200 motion-safe:hover:-translate-y-0.5 hover:shadow-[0_10px_28px_#463e6540] focus-visible:outline-3 focus-visible:outline-offset-4 focus-visible:outline-[#8e6ed8] dark:border-night-border dark:bg-night-surface dark:text-[#f2eff8] button-primary !border-brand !bg-brand text-white shadow-[0_8px_20px_#6553a62b] dark:!border-brand dark:!bg-brand dark:text-white" href={pathFor(lang, 'download')} data-primary-download>{label} <span aria-hidden="true">↗</span></a>
  <div class="mac-choices absolute top-[calc(100%+8px)] left-0 z-10 min-w-[210px] rounded-[14px] border border-[#e9e5ec] bg-white p-[7px] text-left shadow-[0_16px_34px_#26223533] [&[hidden]]:hidden dark:border-[#39404e] dark:bg-[#242a35]" data-mac-choices hidden>
    <a href={downloads.arm}>{copy[lang].download.arm} <span aria-hidden="true">↗</span></a>
    <a href={downloads.intel}>{copy[lang].download.intel} <span aria-hidden="true">↗</span></a>
    <p class="chip-help">{copy[lang].download.chipHelp}</p>
  </div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-download-widget]').forEach((widget, index) => {
    const primary = widget.querySelector<HTMLAnchorElement>('[data-primary-download]');
    const choices = widget.querySelector<HTMLElement>('[data-mac-choices]');
    if (!primary || !choices) return;
    const ua = navigator.userAgent;
    if (/Windows/i.test(ua)) {
      primary.href = 'https://github.com/itvincent-git/codex-usage-desktop/releases/latest/download/codex-usage-desktop-windows-x64-setup.exe';
      primary.firstChild!.textContent = `${widget.dataset.windowsLabel} `;
    } else if (/Macintosh|Mac OS X/i.test(ua)) {
      // Keep the server-rendered download-page link until enhancement is ready.
      const trigger = document.createElement('button');
      trigger.type = 'button';
      trigger.className = primary.className;
      trigger.innerHTML = primary.innerHTML;
      trigger.firstChild!.textContent = `${widget.dataset.macLabel} `;
      trigger.dataset.primaryDownload = '';
      choices.id = `mac-download-choices-${index}`;
      trigger.setAttribute('aria-controls', choices.id);
      trigger.setAttribute('aria-expanded', 'false');
      const setOpen = (open: boolean) => {
        choices.hidden = !open;
        trigger.setAttribute('aria-expanded', String(open));
      };
      trigger.addEventListener('click', () => setOpen(choices.hasAttribute('hidden')));
      widget.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !choices.hidden) {
          event.preventDefault();
          setOpen(false);
          trigger.focus();
        }
      });
      document.addEventListener('pointerdown', (event) => {
        if (!widget.contains(event.target as Node)) setOpen(false);
      });
      widget.addEventListener('focusout', (event) => {
        if (!widget.contains(event.relatedTarget as Node | null)) setOpen(false);
      });
      primary.replaceWith(trigger);
    }
  });
</script>
