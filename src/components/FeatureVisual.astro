---
import type { FeatureSlug } from '../lib/site';
interface Props { slug: FeatureSlug; compact?: boolean; label: string }
const { slug, compact = false, label } = Astro.props;
const bars = [34, 59, 47, 74, 51, 88, 66, 78, 54, 92, 69, 83];
---
<div class:list={['product-visual', `product-visual--${slug}`, { 'product-visual--compact': compact }]} aria-label={label} role="img">
  {slug === 'usage-tracking' && <div class="demo-dashboard">
    <div class="demo-topline"><span class="demo-overline">OVERVIEW</span><span class="demo-range">Last 30 days⌄</span></div>
    <div class="demo-dashboard-grid">
      <div class="demo-summary"><span>ESTIMATED COST</span><strong>$24.80</strong><em>42.6M tokens</em><div class="demo-rule"></div><span>COST DRIVERS</span><div class="demo-driver"><span>Project A</span><b style="width:78%"></b></div><div class="demo-driver"><span>Project B</span><b style="width:51%"></b></div><div class="demo-driver"><span>Project C</span><b style="width:32%"></b></div></div>
      <div class="demo-chart"><div class="demo-legend"><span>● Input</span><span>● Cached</span><span>● Output</span></div><div class="demo-bars">{bars.map((height) => <span style={`height:${height}%`}><i></i></span>)}</div><div class="demo-chart-footer"><div><small>TOKEN BREAKDOWN</small><strong>42.6M</strong></div><div><small>CACHE HIT</small><strong>92.4%</strong></div><div><small>COST / 1M</small><strong>$0.58</strong></div></div></div>
    </div>
    <div class="demo-limits"><div><span>5-Hour Limit</span><strong>74% <small>left</small></strong><b></b></div><div><span>Weekly Limit</span><strong>48% <small>left</small></strong><b></b></div></div>
  </div>}
  {slug === 'session-analysis' && <div class="demo-session"><div class="demo-session-top"><span>SESSION TIMELINE</span><span>Timeline　 Raw JSONL</span></div><div class="demo-session-tags"><span>◷ 18m 42s</span><span>◈ 1.8M tokens</span><span>⚙ 24 tool calls</span></div><div class="demo-event"><span class="demo-event-dot"></span><div><small>09:41 · MESSAGE</small><strong>Explore the project structure</strong><p>Review files and identify the next change.</p></div></div><div class="demo-event demo-event--tool"><span class="demo-event-dot"></span><div><small>09:43 · TOOL CALL</small><strong>Read source files</strong><p>Command completed · 12.4k tokens</p></div></div><div class="demo-event demo-event--patch"><span class="demo-event-dot"></span><div><small>09:47 · PATCH</small><strong>Update dashboard component</strong><p>2 files changed · 1 patch</p></div></div></div>}
  {slug === 'quota-monitoring' && (compact ? <div class="demo-quota"><div><span>5-Hour Limit</span><strong>74% <small>remaining</small></strong><b></b><small>Resets in 2 hours</small></div><div><span>Weekly Limit</span><strong>48% <small>remaining</small></strong><b></b><small>Resets in 2 days</small></div></div> : <img src="/images/menu-bar-settings.png" width="2100" height="1400" alt="" loading="eager" />)}
  {slug === 'cost-analysis' && (compact ? <div class="demo-cost"><div class="demo-cost-head"><span>PROJECT USAGE</span><span>Estimated cost</span></div><div><span>Project A</span><b style="width:81%"></b><strong>$12.40</strong></div><div><span>Project B</span><b style="width:58%"></b><strong>$8.60</strong></div><div><span>Project C</span><b style="width:25%"></b><strong>$3.80</strong></div><small>Based on available model pricing</small></div> : <img src="/images/pricing-catalog.png" width="2400" height="1300" alt="" loading="eager" />)}
</div>
