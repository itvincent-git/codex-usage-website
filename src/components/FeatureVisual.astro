---
import type { FeatureSlug, Lang } from '../lib/site';
import { featureVisualCopy } from '../lib/feature-visual-copy';
interface Props { slug: FeatureSlug; lang: Lang; compact?: boolean; label: string }
const { slug, lang, compact = false, label } = Astro.props;
const t = featureVisualCopy[lang === 'ko' || lang === 'de' ? lang : 'en'];
const bars = [34, 59, 47, 74, 51, 88, 66, 78, 54, 92, 69, 83];
---
<div class:list={['product-visual', `product-visual--${slug}`, { 'product-visual--compact': compact }]} aria-label={label} role="img">
  {slug === 'usage-tracking' && <div class="demo-dashboard">
    <div class="demo-topline"><span class="demo-overline">{t.overview}</span><span class="demo-range">{t.range}⌄</span></div>
    <div class="demo-dashboard-grid">
      <div class="demo-summary"><span>{t.cost}</span><strong>$24.80</strong><em>42.6M {t.tokens}</em><div class="demo-rule"></div><span>{t.drivers}</span><div class="demo-driver"><span>{t.projects[0]}</span><b style="width:78%"></b></div><div class="demo-driver"><span>{t.projects[1]}</span><b style="width:51%"></b></div><div class="demo-driver"><span>{t.projects[2]}</span><b style="width:32%"></b></div></div>
      <div class="demo-chart"><div class="demo-legend"><span>● {t.input}</span><span>● {t.cached}</span><span>● {t.output}</span></div><div class="demo-bars">{bars.map((height) => <span style={`height:${height}%`}><i></i></span>)}</div><div class="demo-chart-footer"><div><small>{t.breakdown}</small><strong>42.6M</strong></div><div><small>{t.cacheHit}</small><strong>92.4%</strong></div><div><small>{t.perMillion}</small><strong>$0.58</strong></div></div></div>
    </div>
    <div class="demo-limits"><div><span>{t.fiveHour}</span><strong>74% <small>{t.left}</small></strong><b></b></div><div><span>{t.weekly}</span><strong>48% <small>{t.left}</small></strong><b></b></div></div>
  </div>}
  {slug === 'session-analysis' && <div class="demo-session-list">
    <div class="demo-session-list-head"><div><strong>{t.sessions}</strong><span>{t.sampleDay}</span></div><span class="demo-session-list-total">{t.dayTotal} <b>2.45M {t.tokens}</b></span></div>
    <div class="demo-session-row"><div class="demo-session-identity"><strong>{t.tasks[0]}</strong><span>{t.projects[0]} · {t.sampleModel}</span><small>09:40</small></div><div class="demo-session-tokens"><span>{t.total}</span><strong>1.09M</strong><small>{t.input} 1.08M · {t.cached} 992.5K · {t.output} 5.1K</small><i></i></div><div class="demo-session-quota"><span>{t.shortFiveHour} <b>{t.used[0]}</b></span><span>{t.shortWeekly} <b>{t.used[3]}</b></span></div></div>
    <div class="demo-session-row"><div class="demo-session-identity"><strong>{t.tasks[1]}</strong><span>{t.projects[1]} · {t.sampleModel}</span><small>08:15</small></div><div class="demo-session-tokens"><span>{t.total}</span><strong>902.5K</strong><small>{t.input} 899K · {t.cached} 852.9K · {t.output} 3.5K</small><i></i></div><div class="demo-session-quota"><span>{t.shortFiveHour} <b>{t.used[1]}</b></span><span>{t.shortWeekly} <b>{t.used[2]}</b></span></div></div>
    <div class="demo-session-row"><div class="demo-session-identity"><strong>{t.tasks[2]}</strong><span>{t.projects[2]} · {t.sampleModel}</span><small>07:30</small></div><div class="demo-session-tokens"><span>{t.total}</span><strong>454.2K</strong><small>{t.input} 450.2K · {t.cached} 401.9K · {t.output} 4K</small><i></i></div><div class="demo-session-quota"><span>{t.shortFiveHour} <b>{t.used[2]}</b></span><span>{t.shortWeekly} <b>{t.used[3]}</b></span></div></div>
  </div>}
  {slug === 'quota-monitoring' && <div class="demo-quota"><div><span>{t.fiveHour}</span><strong>74% <small>{t.remaining}</small></strong><b></b><small>{t.resets[0]}</small></div><div><span>{t.weekly}</span><strong>48% <small>{t.remaining}</small></strong><b></b><small>{t.resets[1]}</small></div></div>}
  {slug === 'cost-analysis' && <div class="demo-cost"><div class="demo-cost-head"><span>{t.projectUsage}</span><span>{t.cost}</span></div><div><span>{t.projects[0]}</span><b style="width:81%"></b><strong>$12.40</strong></div><div><span>{t.projects[1]}</span><b style="width:58%"></b><strong>$8.60</strong></div><div><span>{t.projects[2]}</span><b style="width:25%"></b><strong>$3.80</strong></div><small>{t.pricing}</small></div>}
</div>
