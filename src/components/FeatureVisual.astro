---
import { tw } from '../styles/utilities';
import type { FeatureSlug } from '../lib/site';
interface Props { slug: FeatureSlug; compact?: boolean; label: string }
const { slug, compact = false, label } = Astro.props;
const bars = ['h-[34%]', 'h-[59%]', 'h-[47%]', 'h-[74%]', 'h-[51%]', 'h-[88%]', 'h-[66%]', 'h-[78%]', 'h-[54%]', 'h-[92%]', 'h-[69%]', 'h-[83%]'];
---
<div class={tw('product-visual', `product-visual--${slug}`, compact ? 'product-visual--compact' : '')} aria-label={label} role="img">
  {slug === 'usage-tracking' && <div class={tw('demo-dashboard')}>
    <div class={tw('demo-topline')}><span class={tw('demo-overline')}>OVERVIEW</span><span class={tw('demo-range')}>Last 30 days⌄</span></div>
    <div class={tw('demo-dashboard-grid')}>
      <div class={tw('demo-summary')}><span>ESTIMATED COST</span><strong>$24.80</strong><em>42.6M tokens</em><div class={tw('demo-rule')}></div><span>COST DRIVERS</span><div class={tw('demo-driver')}><span>Project A</span><b class="w-[78%]"></b></div><div class={tw('demo-driver')}><span>Project B</span><b class="w-[51%]"></b></div><div class={tw('demo-driver')}><span>Project C</span><b class="w-[32%]"></b></div></div>
      <div class={tw('demo-chart')}><div class={tw('demo-legend')}><span>● Input</span><span>● Cached</span><span>● Output</span></div><div class={tw('demo-bars')}>{bars.map((height) => <span class={height}><i></i></span>)}</div><div class={tw('demo-chart-footer')}><div><small>TOKEN BREAKDOWN</small><strong>42.6M</strong></div><div><small>CACHE HIT</small><strong>92.4%</strong></div><div><small>COST / 1M</small><strong>$0.58</strong></div></div></div>
    </div>
    <div class={tw('demo-limits')}><div><span>5-Hour Limit</span><strong>74% <small>left</small></strong><b></b></div><div><span>Weekly Limit</span><strong>48% <small>left</small></strong><b></b></div></div>
  </div>}
  {slug === 'session-analysis' && <div class={tw('demo-session-list')}>
    <div class={tw('demo-session-list-head')}><div><strong>Session details</strong><span>Sample day · 3 sessions</span></div><span class={tw('demo-session-list-total')}>Day total <b>2.45M tokens</b></span></div>
    <div class={tw('demo-session-row')}><div class={tw('demo-session-identity')}><strong>Review dashboard</strong><span>Sample Project A · model example</span><small>09:40 AM</small></div><div class={tw('demo-session-tokens')}><span>Total tokens</span><strong>1.09M</strong><small>Input 1.08M · Cached 992.5K · Output 5.1K</small><i></i></div><div class={tw('demo-session-quota')}><span>5-hour <b>Approx. 4% used</b></span><span>Weekly <b>Approx. &lt;1% used</b></span></div></div>
    <div class={tw('demo-session-row')}><div class={tw('demo-session-identity')}><strong>Explore project files</strong><span>Sample Project B · model example</span><small>08:15 AM</small></div><div class={tw('demo-session-tokens')}><span>Total tokens</span><strong>902.5K</strong><small>Input 899K · Cached 852.9K · Output 3.5K</small><i></i></div><div class={tw('demo-session-quota')}><span>5-hour <b>Approx. 3% used</b></span><span>Weekly <b>Approx. 1% used</b></span></div></div>
    <div class={tw('demo-session-row')}><div class={tw('demo-session-identity')}><strong>Plan next steps</strong><span>Sample Project C · model example</span><small>07:30 AM</small></div><div class={tw('demo-session-tokens')}><span>Total tokens</span><strong>454.2K</strong><small>Input 450.2K · Cached 401.9K · Output 4K</small><i></i></div><div class={tw('demo-session-quota')}><span>5-hour <b>Approx. 1% used</b></span><span>Weekly <b>Approx. &lt;1% used</b></span></div></div>
  </div>}
  {slug === 'quota-monitoring' && <div class={tw('demo-quota')}><div><span>5-Hour Limit</span><strong>74% <small>remaining</small></strong><b></b><small>Resets in 2 hours</small></div><div><span>Weekly Limit</span><strong>48% <small>remaining</small></strong><b></b><small>Resets in 2 days</small></div></div>}
  {slug === 'cost-analysis' && <div class={tw('demo-cost')}><div class={tw('demo-cost-head')}><span>PROJECT USAGE</span><span>Estimated cost</span></div><div><span>Project A</span><b class="w-[81%]"></b><strong>$12.40</strong></div><div><span>Project B</span><b class="w-[58%]"></b><strong>$8.60</strong></div><div><span>Project C</span><b class="w-[25%]"></b><strong>$3.80</strong></div><small>Based on available model pricing</small></div>}
</div>
