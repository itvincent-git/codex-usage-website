---
import HeaderControls from '../components/HeaderControls';
import { copy, docSlugs, equivalents, featureSlugs, pathFor, repo, site, type Lang } from '../lib/site';
import '../styles/global.css';
import '../styles/visuals.css';

interface Props { lang: Lang; section?: string; title: string; description: string; image?: string; schema?: Record<string, unknown>; noindex?: boolean }
const { lang, section = '', title, description, image = '/og.png', schema, noindex = false } = Astro.props;
const t = copy[lang];
const canonical = `${site}${pathFor(lang, section)}`;
const featureLinks = featureSlugs.map((slug) => ({ label: t.features[slug].name, href: pathFor(lang, slug) }));
const navLinks = [
  { label: t.nav.features, href: `${pathFor(lang)}#features` },
  { label: t.nav.docs, href: pathFor(lang, 'docs') },
  { label: t.nav.github, href: repo },
];
const jsonLd = schema ?? { '@context': 'https://schema.org', '@type': 'WebPage', name: title, description, url: canonical, inLanguage: t.locale };
---
<!doctype html>
<html lang={t.locale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-M7DT21GQV5"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-M7DT21GQV5');
    </script>
    <meta name="theme-color" content="#f9f8f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161b25" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex,follow" /> : <>
      <link rel="canonical" href={canonical} />
      {equivalents(section).map(({ lang: code, href }) => <link rel="alternate" hreflang={copy[code].locale} href={href} />)}
      <link rel="alternate" hreflang="x-default" href={`${site}${pathFor('en', section)}`} />
    </>}
    <link rel="icon" href="/favicon.png" type="image/png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Codex Usage Desktop" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site}${image}`} />
    <meta property="og:locale" content={t.locale.replace('-', '_')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site}${image}`} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="m-0 bg-canvas font-sans text-ink dark:bg-night-canvas dark:text-night-ink">
    <a class="skip-link" href="#main-content">{t.nav.skipContent}</a>
    <div class:list={['site-shell', section.startsWith('docs/') ? 'overflow-x-clip' : 'overflow-hidden']}>
      <header class="site-header relative z-20 flex h-[84px] items-center justify-between gap-7 max-[700px]:h-[70px] wrap mx-auto w-[min(1180px,calc(100%-48px))] max-[700px]:w-[min(560px,calc(100%-32px))]">
        <a class="brand inline-flex items-center gap-2.5 whitespace-nowrap text-[17px] font-semibold tracking-[-.045em] [&_img]:rounded-[10px] [&_img]:shadow-[0_4px_14px_#7775a52b] [&_strong]:text-[#8173bc] dark:[&_strong]:text-brand-light" href={pathFor(lang)} aria-label={`Codex Usage Desktop — ${t.common.home}`}><img src="/favicon.png" alt="" width="34" height="34" /> <span>Codex <strong>Usage</strong></span></a>
        <nav class="desktop-nav ml-auto flex items-center gap-[37px] text-sm font-semibold text-[#646a75] [&_a:hover]:text-[#8468c5] max-[900px]:gap-4 max-[700px]:hidden dark:text-[#bec0ca]" aria-label="Primary">
          <div class="feature-nav">
            <a href={`${pathFor(lang)}#features`}>{t.nav.features}</a>
            <details class="feature-disclosure">
              <summary aria-label={t.nav.features} aria-controls="feature-links"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></summary>
              <div id="feature-links" class="feature-nav-popover">{featureLinks.map((item) => <a href={item.href}>{item.label}</a>)}</div>
            </details>
          </div>
          <a href={pathFor(lang, 'docs')}>{t.nav.docs}</a>
          <a href={repo} target="_blank" rel="noopener noreferrer">{t.nav.github}</a>
        </nav>
        <div class="header-actions flex items-center gap-4 max-[700px]:gap-[3px]">
          <a class="header-download max-[700px]:hidden button inline-flex min-h-13 items-center justify-center gap-4 rounded-2xl border border-surface-border bg-white px-6 text-[15px] font-bold transition-[transform,box-shadow] duration-200 motion-safe:hover:-translate-y-0.5 hover:shadow-[0_10px_28px_#463e6540] focus-visible:outline-3 focus-visible:outline-offset-4 focus-visible:outline-[#8e6ed8] dark:border-night-border dark:bg-night-surface dark:text-[#f2eff8] button-small min-h-10 gap-2.5 rounded-xl px-[17px] text-[13px] button-primary !border-brand !bg-brand text-white shadow-[0_8px_20px_#6553a62b] dark:!border-brand dark:!bg-brand dark:text-white" href={pathFor(lang, 'download')}>{t.nav.download} <span aria-hidden="true">↗</span></a>
          <HeaderControls client:load languageLabel={t.nav.language} menuLabel={t.nav.menu} closeMenuLabel={t.nav.closeMenu} currentLanguage={t.name} languages={equivalents(section).map(({ lang: code }) => ({ label: copy[code].name, href: pathFor(code, section) }))} links={navLinks} download={{ label: t.nav.download, href: pathFor(lang, 'download') }} />
        </div>
      </header>
      <main id={section.startsWith('docs/') ? undefined : 'main-content'} tabindex={section.startsWith('docs/') ? undefined : -1}><slot /></main>
      <footer class="site-footer bg-[#242632] pt-[70px] text-[#e5e5ed] max-[700px]:pt-[55px]">
        <div class="wrap mx-auto w-[min(1180px,calc(100%-48px))] max-[700px]:w-[min(560px,calc(100%-32px))] footer-grid grid grid-cols-[2fr_repeat(3,1fr)] gap-[35px] max-[900px]:grid-cols-2">
          <div><a class="brand inline-flex items-center gap-2.5 whitespace-nowrap text-[17px] font-semibold tracking-[-.045em] [&_img]:rounded-[10px] [&_img]:shadow-[0_4px_14px_#7775a52b] [&_strong]:text-[#8173bc] dark:[&_strong]:text-brand-light" href={pathFor(lang)}><img src="/favicon.png" alt="" width="32" height="32" /> <span>Codex <strong>Usage</strong></span></a><p>{t.common.built}</p></div>
          <div><strong>{t.nav.features}</strong>{featureLinks.map((item) => <a href={item.href}>{item.label}</a>)}</div>
          <div><strong>{t.nav.docs}</strong><a href={pathFor(lang, 'docs')}>{t.docs.all}</a><a href={pathFor(lang, `docs/${docSlugs[0]}`)}>{t.docs.names['getting-started']}</a><a href={pathFor(lang, `docs/${docSlugs[7]}`)}>{t.docs.names.privacy}</a></div>
          <div><strong>{t.common.get}</strong><a href={pathFor(lang, 'download')}>{t.nav.download}</a><a href={repo}>{t.nav.github}</a><a href={`${repo}/issues`}>Issues</a></div>
        </div>
        <div class="wrap mx-auto w-[min(1180px,calc(100%-48px))] max-[700px]:w-[min(560px,calc(100%-32px))] footer-bottom mt-[62px] flex justify-between border-t border-[#41424c] py-6 text-xs text-[#a7aab7] max-[700px]:block max-[700px]:leading-loose"><span>© {new Date().getFullYear()} {t.common.copyright}</span><span>{t.common.built}</span></div>
      </footer>
    </div>
    <script>
      const nav = document.querySelector<HTMLElement>('.feature-nav');
      const disclosure = nav?.querySelector<HTMLDetailsElement>('details');
      const trigger = disclosure?.querySelector('summary');
      if (nav && disclosure && trigger) {
        const close = () => { disclosure.open = false; };
        nav.addEventListener('pointerenter', (event) => {
          if (event.pointerType === 'mouse') disclosure.open = true;
        });
        nav.addEventListener('pointerleave', () => {
          if (!nav.contains(document.activeElement)) close();
        });
        nav.addEventListener('focusout', (event) => {
          if (!nav.contains(event.relatedTarget as Node | null)) close();
        });
        document.addEventListener('pointerdown', (event) => {
          if (!nav.contains(event.target as Node)) close();
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && disclosure.open) {
            event.preventDefault();
            close();
            trigger.focus();
          }
        });
      }
    </script>
  </body>
</html>
