---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PrimaryDownload from '../components/PrimaryDownload.astro';
import FeatureVisual from '../components/FeatureVisual.astro';
import SessionDetailVisual from '../components/SessionDetailVisual.astro';
import { copy, docSlugs, downloads, featureSlugs, languages, pathFor, releases, repo, site, type DocSlug, type FeatureSlug, type Lang } from '../lib/site';

export async function getStaticPaths() {
  const routes = [];
  for (const lang of languages) {
    for (const section of ['download', ...featureSlugs, 'docs', ...docSlugs.map((slug) => `docs/${slug}`)]) {
      routes.push({ params: { path: pathFor(lang, section).slice(1, -1) }, props: { lang, section } });
    }
  }
  return routes;
}

interface Props { lang: Lang; section: string }
const { lang, section } = Astro.props;
const t = copy[lang];
const isDownload = section === 'download';
const isDocsIndex = section === 'docs';
const isDoc = section.startsWith('docs/');
const docSlug = isDoc ? section.slice(5) as DocSlug : undefined;
const featureSlug = !isDownload && !isDocsIndex && !isDoc ? section as FeatureSlug : undefined;
const feature = featureSlug ? t.features[featureSlug] : undefined;
const entry = docSlug ? (await getCollection('docs')).find((item) => item.id === `${lang}/${docSlug}`) : undefined;
if (docSlug && !entry) throw new Error(`Missing doc: ${lang}/${docSlug}`);
const content = entry ? await render(entry) : undefined;
const title = isDownload ? t.download.title : isDocsIndex ? t.docs.title : feature ? feature.title : entry?.data.title ?? '';
const description = isDownload ? t.download.lead : isDocsIndex ? t.docs.lead : feature ? feature.description : entry?.data.description ?? '';
const schema = isDownload ? { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'Codex Usage Desktop', description: t.download.lead, applicationCategory: 'DeveloperApplication', operatingSystem: 'macOS, Windows 10, Windows 11', isAccessibleForFree: true, downloadUrl: [downloads.windows, downloads.arm, downloads.intel], url: `${site}${pathFor(lang, section)}`, inLanguage: t.locale } : isDoc ? { '@context': 'https://schema.org', '@type': 'TechArticle', headline: title, description, inLanguage: t.locale, url: `${site}${pathFor(lang, section)}`, publisher: { '@type': 'Organization', name: 'Codex Usage Desktop', url: repo } } : undefined;
---
<BaseLayout lang={lang} section={section} title={`${title} | Codex Usage Desktop`} description={description} schema={schema}>
  {isDownload && <>
    <section class="page-hero py-[80px] pb-[55px] text-center max-[700px]:py-[62px] max-[700px]:pb-[42px]"><div class="wrap mx-auto w-[min(1180px,calc(100%-48px))] max-[700px]:w-[min(560px,calc(100%-32px))]"><span class="eyebrow inline-flex items-center gap-2 text-[11px] font-extrabold uppercase tracking-[.14em] text-brand-label before:size-2 before:rounded-full before:bg-brand-dot before:shadow-[0_0_0_5px_#e9e0fb] before:content-[''] dark:text-brand-light">{t.nav.download}</span><h1>{t.download.title}</h1><p class="lead">{t.download.lead}</p></div></section>
    <div class="wrap mx-auto w-[min(1180px,calc(100%-48px))] max-[700px]:w-[min(560px,calc(100%-32px))] download-grid grid grid-cols-2 gap-[22px] py-10 pb-[35px] max-[700px]:grid-cols-1 max-[700px]:pt-5">
      <section class="download-card rounded-3xl border border-[#e9e5eb] bg-white p-8 shadow-[0_10px_35px_#5956750c] dark:border-[#39404e] dark:bg-[#242a35]"><span class="eyebrow inline-flex items-center gap-2 text-[11px] font-extrabold uppercase tracking-[.14em] text-brand-label before:size-2 before:rounded-full before:bg-brand-dot before:shadow-[0_0_0_5px_#e9e0fb] before:content-[''] dark:text-brand-light">Windows</span><h2>{t.download.windows}</h2><p>{t.download.windowsNote}</p><a class="button inline-flex min-h-13 items-center justify-center gap-4 rounded-2xl border border-surface-border bg-white px-6 text-[15px] font-bold transition-[transform,box-shadow] duration-200 hover:-translate-y-0.5 hover:shadow-[0_10px_28px_#463e6540] focus-visible:outline-3 focus-visible:outline-offset-4 focus-visible:outline-[#8e6ed8] dark:border-night-border dark:bg-night-surface dark:text-[#f2eff8] button-primary !border-brand !bg-brand text-white shadow-[0_8px_20px_#6553a62b] dark:!border-brand dark:!bg-brand dark:text-white" href={downloads.windows}>{t.nav.download} Windows <span aria-hidden="true">↗</span></a></section>
      <section class="download-card rounded-3xl border border-[#e9e5eb] bg-white p-8 shadow-[0_10px_35px_#5956750c] dark:border-[#39404e] dark:bg-[#242a35]"><span class="eyebrow inline-flex items-center gap-2 text-[11px] font-extrabold uppercase tracking-[.14em] text-brand-label before:size-2 before:rounded-full before:bg-brand-dot before:shadow-[0_0_0_5px_#e9e0fb] before:content-[''] dark:text-brand-light">Mac</span><h2>{t.download.mac}</h2><p>{t.download.macNote}</p><div class="download-options flex flex-wrap gap-2.5"><a class="button inline-flex min-h-13 items-center justify-center gap-4 rounded-2xl border border-surface-border bg-white px-6 text-[15px] font-bold transition-[transform,box-shadow] duration-200 hover:-translate-y-0.5 hover:shadow-[0_10px_28px_#463e6540] focus-visible:outline-3 focus-visible:outline-offset-4 focus-visible:outline-[#8e6ed8] dark:border-night-border dark:bg-night-surface dark:text-[#f2eff8] button-primary !border-brand !bg-brand text-white shadow-[0_8px_20px_#6553a62b] dark:!border-brand dark:!bg-brand dark:text-white" href={downloads.arm}>{t.download.arm} <span aria-hidden="true">↗</span></a><a class="button inline-flex min-h-13 items-center justify-center gap-4 rounded-2xl border border-surface-border bg-white px-6 text-[15px] font-bold transition-[transform,box-shadow] duration-200 hover:-translate-y-0.5 hover:shadow-[0_10px_28px_#463e6540] focus-visible:outline-3 focus-visible:outline-offset-4 focus-visible:outline-[#8e6ed8] dark:border-night-border dark:bg-night-surface dark:text-[#f2eff8]" href={downloads.intel}>{t.download.intel} <span aria-hidden="true">↗</span></a></div></section>
    </div>
    <div class="wrap mx-auto w-[min(1180px,calc(100%-48px))] max-[700px]:w-[min(560px,calc(100%-32px))] download-notes grid grid-cols-2 gap-[18px] pb-[90px] max-[700px]:grid-cols-1 max-[700px]:pb-[55px]"><div class="note rounded-[20px] bg-[#f1eff6] p-[25px] dark:bg-[#282c3b]"><h3>{t.download.requirements}</h3><p>{t.download.requireBody} <a class="text-link font-bold text-brand-link hover:underline dark:text-brand-light" href={pathFor(lang, 'docs/getting-started')}>{t.common.learn} →</a></p></div><div class="note rounded-[20px] bg-[#f1eff6] p-[25px] dark:bg-[#282c3b]"><h3>{t.download.firstLaunch}</h3><p>{t.download.firstLaunchBody}</p></div></div>
    <a class="text-link font-bold text-brand-link hover:underline dark:text-brand-light release-link mb-[90px] block text-center max-[700px]:mb-[60px]" href={releases}>{t.download.releases} ↗</a>
  </>}
  {feature && featureSlug && <>
    <section class="page-hero py-[80px] pb-[55px] text-center max-[700px]:py-[62px] max-[700px]:pb-[42px]"><div class="wrap mx-auto w-[min(1180px,calc(100%-48px))] max-[700px]:w-[min(560px,calc(100%-32px))]"><span class="eyebrow inline-flex items-center gap-2 text-[11px] font-extrabold uppercase tracking-[.14em] text-brand-label before:size-2 before:rounded-full before:bg-brand-dot before:shadow-[0_0_0_5px_#e9e0fb] before:content-[''] dark:text-brand-light">{feature.eyebrow}</span><h1>{feature.title}</h1><p class="lead">{feature.description}</p></div></section>
    <section class="wrap mx-auto w-[min(1180px,calc(100%-48px))] max-[700px]:w-[min(560px,calc(100%-32px))] feature-layout py-[65px] pb-[105px] max-[700px]:py-[50px] max-[700px]:pb-[75px]"><div class="feature-detail grid grid-cols-[1fr_1.12fr] items-center gap-[55px] max-[900px]:gap-[30px] max-[700px]:grid-cols-1"><div><span class="eyebrow inline-flex items-center gap-2 text-[11px] font-extrabold uppercase tracking-[.14em] text-brand-label before:size-2 before:rounded-full before:bg-brand-dot before:shadow-[0_0_0_5px_#e9e0fb] before:content-[''] dark:text-brand-light">Codex Usage Desktop</span><h2>{feature.name}</h2><ul class="point-list my-6 mb-[30px] grid list-none gap-4 p-0">{feature.points.map((point) => <li>{point}</li>)}</ul><PrimaryDownload lang={lang} label={t.common.get} /></div><div class="feature-screenshot rounded-3xl border border-[#e8e2ed] bg-white p-3 shadow-[0_25px_70px_#64598324] max-[700px]:order-first dark:border-[#414657] dark:bg-[#272b37]"><FeatureVisual slug={featureSlug} label={feature.imageAlt} /><p class="visual-note">{t.home.visualNote}</p></div></div></section>
    {featureSlug === 'session-analysis' && <section class="session-detail-section"><div class="wrap mx-auto w-[min(1180px,calc(100%-48px))] max-[700px]:w-[min(560px,calc(100%-32px))]"><div class="section-heading mx-auto mb-12 max-w-[670px] text-center"><span class="eyebrow inline-flex items-center gap-2 text-[11px] font-extrabold uppercase tracking-[.14em] text-brand-label before:size-2 before:rounded-full before:bg-brand-dot before:shadow-[0_0_0_5px_#e9e0fb] before:content-[''] dark:text-brand-light">{t.sessionDetail.eyebrow}</span><h2>{t.sessionDetail.title}</h2><p>{t.sessionDetail.body}</p></div><SessionDetailVisual lang={lang} /><p class="visual-note">{t.sessionDetail.note}</p></div></section>}
    <section class="related bg-[#f1eff5] py-[72px] dark:bg-[#252538]"><div class="wrap mx-auto w-[min(1180px,calc(100%-48px))] max-[700px]:w-[min(560px,calc(100%-32px))]"><div class="section-heading mx-auto mb-12 max-w-[670px] text-center"><h2>{t.home.sectionTitle}</h2></div><div class="related-grid grid grid-cols-3 gap-4 max-[700px]:grid-cols-1">{featureSlugs.filter((slug) => slug !== featureSlug).map((slug) => <a href={pathFor(lang, slug)}>{t.features[slug].name}<span>↗</span></a>)}</div></div></section>
  </>}
  {isDocsIndex && <>
    <section class="page-hero py-[80px] pb-[55px] text-center max-[700px]:py-[62px] max-[700px]:pb-[42px]"><div class="wrap mx-auto w-[min(1180px,calc(100%-48px))] max-[700px]:w-[min(560px,calc(100%-32px))]"><span class="eyebrow inline-flex items-center gap-2 text-[11px] font-extrabold uppercase tracking-[.14em] text-brand-label before:size-2 before:rounded-full before:bg-brand-dot before:shadow-[0_0_0_5px_#e9e0fb] before:content-[''] dark:text-brand-light">{t.nav.docs}</span><h1>{t.docs.title}</h1><p class="lead">{t.docs.lead}</p></div></section>
    <div class="wrap mx-auto w-[min(1180px,calc(100%-48px))] max-[700px]:w-[min(560px,calc(100%-32px))] docs-grid grid grid-cols-3 gap-[15px] pt-[30px] pb-[100px] max-[700px]:grid-cols-1 max-[700px]:pb-[70px]">{docSlugs.map((slug) => <a class="doc-card flex min-h-[172px] flex-col justify-between rounded-[20px] border border-[#ebe8ea] bg-white p-[26px] hover:border-[#baace3] hover:shadow-[0_15px_30px_#6553a619] dark:border-[#39404e] dark:bg-[#242a35]" href={pathFor(lang, `docs/${slug}`)}><strong>{t.docs.names[slug]}</strong><span>{t.docs.open} ↗</span></a>)}</div>
  </>}
  {entry && content && docSlug && <div class="wrap mx-auto w-[min(1180px,calc(100%-48px))] max-[700px]:w-[min(560px,calc(100%-32px))] docs-layout grid grid-cols-[245px_minmax(0,1fr)] gap-[72px] pt-[60px] pb-[110px] max-[900px]:grid-cols-[205px_1fr] max-[900px]:gap-[35px] max-[700px]:block max-[700px]:pt-[35px]"><aside class="docs-sidebar sticky top-[22px] grid content-start gap-0.5 self-start max-[700px]:static max-[700px]:mb-[45px] max-[700px]:flex max-[700px]:gap-[3px] max-[700px]:overflow-x-auto max-[700px]:pb-2.5" aria-label={t.docs.all}><h2>{t.docs.all}</h2>{docSlugs.map((slug) => <a href={pathFor(lang, `docs/${slug}`)} aria-current={slug === docSlug ? 'page' : undefined}>{t.docs.names[slug]}</a>)}</aside><article class="docs-article max-w-[760px]"><div class="breadcrumbs"><a href={pathFor(lang, 'docs')}>{t.nav.docs}</a> / {entry.data.title}</div><h1>{entry.data.title}</h1><p class="article-lead">{entry.data.description}</p><div class="prose"><content.Content /></div><a class="text-link font-bold text-brand-link hover:underline dark:text-brand-light doc-edit" href={`${repo}/tree/main/README${lang === 'en' ? '' : `_${lang}`}.md`}>{t.docs.edit} ↗</a></article></div>}
</BaseLayout>
